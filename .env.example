# Google Maps JavaScript API key (required for Contact page map)
# Get a key at: https://console.cloud.google.com/google/maps-apis
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Enquiry form email (Render: set in Dashboard → Environment)
# Gmail: use App Password https://support.google.com/accounts/answer/185833
SMTP_EMAIL=yourgmail@gmail.com
SMTP_PASSWORD=your_app_password
